{
  "name": "ravefold",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-folders",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test:unit": "node --test tests/*.test.ts",
    "register:local-source": "node scripts/register-local-source.ts",
    "evaluate:local-audio": "node scripts/evaluate-local-audio.ts",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.codex\" \"#docs/research\" \"#tmp\" \"#dist\" \"#samples\" \"#.impeccable/review\" \"#test-results\" \"#playwright-report\"",
    "format:check": "prettier . --check",
    "quality:quick": "node scripts/quality-quick.ts",
    "quality:full": "node scripts/quality-full.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@cruxgarden/plasma-ui": "0.7.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
